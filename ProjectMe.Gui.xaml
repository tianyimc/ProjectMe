<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ProjectMe 管理器"
        Width="1280" Height="820" MinWidth="1120" MinHeight="680"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBackground}"
        FontFamily="{DynamicResource BodyFontFamily}" FontSize="14">
  <Window.Resources>
    <Style TargetType="Button">
      <Setter Property="Padding" Value="14,8"/>
      <Setter Property="Margin" Value="0,0,8,0"/>
      <Setter Property="Background" Value="{DynamicResource SurfaceBackground}"/>
      <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="MinHeight" Value="34"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
    </Style>
    <Style x:Key="PurpleButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="{DynamicResource PurpleBrush}"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="BorderBrush" Value="{DynamicResource PurpleBrush}"/>
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Padding" Value="10,7"/>
      <Setter Property="Margin" Value="0,3,0,12"/>
      <Setter Property="Background" Value="{DynamicResource InputBackground}"/>
      <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
    </Style>
    <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
      <Setter Property="Margin" Value="0,0,0,2"/>
    </Style>
    <Style x:Key="GridTextStyle" TargetType="TextBlock">
      <Setter Property="TextWrapping" Value="Wrap"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Margin" Value="8,3"/>
      <Setter Property="ToolTip" Value="{Binding RelativeSource={RelativeSource Self}, Path=Text}"/>
    </Style>
    <Style x:Key="TitleTextStyle" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="{DynamicResource TitleFontFamily}"/>
      <Setter Property="FontWeight" Value="Normal"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style TargetType="DataGridColumnHeader">
      <Setter Property="Background" Value="{DynamicResource SurfaceMuted}"/>
      <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Padding" Value="12,9"/>
    </Style>
    <Style TargetType="DataGridRow">
      <Setter Property="Background" Value="{DynamicResource SurfaceBackground}"/>
      <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
      <Style.Triggers>
        <Trigger Property="IsSelected" Value="True">
          <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
          <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
        </Trigger>
      </Style.Triggers>
    </Style>
  </Window.Resources>

  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="76"/><RowDefinition Height="*"/><RowDefinition Height="44"/></Grid.RowDefinitions>
    <Grid.ColumnDefinitions><ColumnDefinition Width="224"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

    <Border Grid.RowSpan="3" Background="{DynamicResource SidebarBackground}" Padding="18,24,18,18">
      <DockPanel>
        <StackPanel DockPanel.Dock="Bottom">
          <TextBlock x:Name="SidebarVersionText" Foreground="{DynamicResource SidebarMuted}" Margin="8,18,8,2" TextWrapping="Wrap"/>
          <TextBlock Margin="8,0,8,0"><Hyperlink x:Name="AuthorLink" NavigateUri="https://tianyimc.com" Foreground="{DynamicResource SidebarMuted}" TextDecorations="None">tianyimc.com</Hyperlink></TextBlock>
        </StackPanel>
        <StackPanel>
          <TextBlock Text="ProjectMe" Style="{StaticResource TitleTextStyle}" Foreground="White" FontSize="24" Margin="8,0,8,2"/>
          <TextBlock Text="个人文集工作台" Foreground="{DynamicResource SidebarMuted}" Margin="8,0,8,34"/>
          <Button x:Name="ArticlesNavButton" Content="文章管理" HorizontalContentAlignment="Left" Background="{DynamicResource SidebarActive}" Foreground="White" BorderBrush="Transparent" Margin="0,0,0,6"/>
          <Button x:Name="MaintenanceNavButton" Content="预览与维护" HorizontalContentAlignment="Left" Background="Transparent" Foreground="{DynamicResource SidebarText}" BorderBrush="Transparent" Margin="0,0,0,6"/>
          <Button x:Name="TimelineNavButton" Content="时间轴" HorizontalContentAlignment="Left" Background="Transparent" Foreground="{DynamicResource SidebarText}" BorderBrush="Transparent" Margin="0,0,0,6"/>
          <Button x:Name="AboutNavButton" Content="关于项目" HorizontalContentAlignment="Left" Background="Transparent" Foreground="{DynamicResource SidebarText}" BorderBrush="Transparent"/>
        </StackPanel>
      </DockPanel>
    </Border>

    <Grid Grid.Column="1" Grid.Row="0" Margin="30,16,30,8">
      <Grid x:Name="ArticlesHeaderPanel">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock Text="文章管理" Style="{StaticResource TitleTextStyle}" FontSize="25" Foreground="{DynamicResource TextPrimary}"/>
          <TextBlock x:Name="HeaderSubtitleText" Foreground="{DynamicResource TextSecondary}" Margin="0,3,0,0" TextWrapping="Wrap"/>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
          <TextBox x:Name="SearchBox" Width="230" Margin="0,0,10,0" ToolTip="搜索文章标题、类别或节"/>
          <Button x:Name="RefreshButton" Content="刷新"/>
          <Button x:Name="NewArticleButton" Content="新建文章" Style="{StaticResource PrimaryButton}"/>
          <Button x:Name="ImportObsidianButton" Content="从 Obsidian 导入" Style="{StaticResource PurpleButton}" Margin="0"/>
        </StackPanel>
      </Grid>
      <Grid x:Name="MaintenanceHeaderPanel" Visibility="Collapsed">
        <StackPanel>
          <TextBlock Text="预览与维护" Style="{StaticResource TitleTextStyle}" FontSize="25" Foreground="{DynamicResource TextPrimary}"/>
          <TextBlock Text="管理本地预览、项目检查、日志和版本回滚" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap"/>
        </StackPanel>
      </Grid>
      <Grid x:Name="TimelineHeaderPanel" Visibility="Collapsed">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock Text="时间轴" Style="{StaticResource TitleTextStyle}" FontSize="25" Foreground="{DynamicResource TextPrimary}"/>
          <TextBlock Text="选择、编辑和维护值得保留的历史节点" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap"/>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
          <TextBox x:Name="TimelineSearchBox" Width="240" Margin="0,0,10,0" ToolTip="搜索标题、slug 或时间轴说明"/>
          <Button x:Name="TimelineRefreshButton" Content="刷新"/>
          <Button x:Name="TimelineSelectButton" Content="选入文章" Style="{StaticResource PrimaryButton}" Margin="0"/>
        </StackPanel>
      </Grid>
    </Grid>

    <Grid Grid.Column="1" Grid.Row="1" Margin="30,4,30,18">
      <Grid x:Name="ArticlesPage">
        <Grid.ColumnDefinitions><ColumnDefinition Width="1.08*"/><ColumnDefinition Width="0.92*"/></Grid.ColumnDefinitions>
        <Border Grid.Column="0" Background="{DynamicResource SurfaceBackground}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12">
          <DataGrid x:Name="ArticleGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False" SelectionMode="Single" SelectionUnit="FullRow" GridLinesVisibility="Horizontal" HeadersVisibility="Column" RowHeight="52" BorderThickness="0" Background="{DynamicResource SurfaceBackground}">
            <DataGrid.Columns>
              <DataGridTextColumn Header="标题" Binding="{Binding title}" SortMemberPath="title" Width="2.2*" ElementStyle="{StaticResource GridTextStyle}"/>
              <DataGridTextColumn Header="类别" Binding="{Binding category}" SortMemberPath="category" Width="*" ElementStyle="{StaticResource GridTextStyle}"/>
              <DataGridTextColumn Header="节" Binding="{Binding section}" SortMemberPath="section" Width="*" ElementStyle="{StaticResource GridTextStyle}"/>
              <DataGridTextColumn Header="日期" Binding="{Binding date}" SortMemberPath="date" Width="*" ElementStyle="{StaticResource GridTextStyle}"/>
            </DataGrid.Columns>
          </DataGrid>
        </Border>
        <Border Grid.Column="1" Background="{DynamicResource SurfaceBackground}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="24" Margin="18,0,0,0">
          <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
            <TextBlock Text="文章属性" Style="{StaticResource TitleTextStyle}" FontSize="18" Foreground="{DynamicResource TextPrimary}"/>
            <TextBlock x:Name="ArticleFileText" Foreground="{DynamicResource TextSecondary}" Margin="0,4,0,22" TextWrapping="Wrap"/>
            <TextBlock Text="标题" Style="{DynamicResource FieldLabelStyle}"/><TextBox x:Name="TitleBox"/>
            <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="14"/><ColumnDefinition/></Grid.ColumnDefinitions>
              <StackPanel><TextBlock Text="类别" Style="{DynamicResource FieldLabelStyle}"/><TextBox x:Name="CategoryBox"/></StackPanel>
              <StackPanel Grid.Column="2"><TextBlock Text="节" Style="{DynamicResource FieldLabelStyle}"/><TextBox x:Name="SectionBox"/></StackPanel>
            </Grid>
            <TextBlock Text="主题标签（逗号分隔）" Style="{DynamicResource FieldLabelStyle}"/><TextBox x:Name="TagsBox"/>
            <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="14"/><ColumnDefinition/></Grid.ColumnDefinitions>
              <StackPanel><TextBlock Text="日期" Style="{DynamicResource FieldLabelStyle}"/><TextBox x:Name="DateBox"/></StackPanel>
              <StackPanel Grid.Column="2"><TextBlock Text="阅读时间" Style="{DynamicResource FieldLabelStyle}"/><TextBox x:Name="ReadingTimeBox"/></StackPanel>
            </Grid>
            <TextBlock Text="摘要" Style="{DynamicResource FieldLabelStyle}"/><TextBox x:Name="ExcerptBox" MinHeight="70" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/>
            <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="14"/><ColumnDefinition/></Grid.ColumnDefinitions>
              <StackPanel><TextBlock Text="目录字体" Style="{DynamicResource FieldLabelStyle}"/><TextBox x:Name="FontBox"/></StackPanel>
              <StackPanel Grid.Column="2"><TextBlock Text="目录颜色" Style="{DynamicResource FieldLabelStyle}"/><TextBox x:Name="ColorBox"/></StackPanel>
            </Grid>
            <StackPanel Orientation="Horizontal" Margin="0,8,0,0"><Button x:Name="SaveArticleButton" Content="保存属性" Style="{StaticResource PrimaryButton}"/><Button x:Name="OpenArticleButton" Content="打开正文"/><Button x:Name="DeleteArticleButton" Content="删除文章" Foreground="#FFFFFF" Background="#B3261E" BorderBrush="#B3261E" IsEnabled="False"/></StackPanel>
          </StackPanel></ScrollViewer>
        </Border>
      </Grid>

      <ScrollViewer x:Name="MaintenancePage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
        <StackPanel>
          <Border Background="{DynamicResource SurfaceBackground}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="24" Margin="0,0,0,16">
            <StackPanel>
              <TextBlock Text="本地预览" Style="{StaticResource TitleTextStyle}" FontSize="18" Foreground="{DynamicResource TextPrimary}"/>
              <TextBlock Text="启动静态服务并在浏览器中查看当前文集。" Foreground="{DynamicResource TextSecondary}" Margin="0,4,0,16" TextWrapping="Wrap"/>
              <StackPanel Orientation="Horizontal"><TextBlock Text="端口" VerticalAlignment="Center" Margin="0,0,8,0"/><TextBox x:Name="MaintenancePortBox" Width="90"/><Button x:Name="MaintenanceStartButton" Content="启动预览" Style="{StaticResource PrimaryButton}"/><Button x:Name="MaintenanceStopButton" Content="停止预览"/><Button x:Name="MaintenanceOpenSiteButton" Content="打开网站"/><Button x:Name="MaintenanceForceStopButton" Content="强停所有预览" Foreground="#FFFFFF" Background="#B3261E" BorderBrush="#B3261E"/></StackPanel>
              <TextBlock x:Name="MaintenanceServiceText" Foreground="{DynamicResource TextSecondary}" Margin="0,8,0,0" TextWrapping="Wrap"/>
            </StackPanel>
          </Border>
          <Border Background="{DynamicResource SurfaceBackground}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="24" Margin="0,0,0,16">
            <StackPanel>
              <TextBlock Text="Obsidian 导入" Style="{StaticResource TitleTextStyle}" FontSize="18" Foreground="{DynamicResource TextPrimary}"/>
              <TextBlock Text="设置从“从 Obsidian 导入”打开目录选择窗口时的默认位置。" Foreground="{DynamicResource TextSecondary}" Margin="0,4,0,16" TextWrapping="Wrap"/>
              <TextBlock Text="默认导入源" Style="{DynamicResource FieldLabelStyle}"/>
              <DockPanel LastChildFill="True"><Button x:Name="ClearDefaultObsidianSourceButton" DockPanel.Dock="Right" Content="清除设置" Margin="8,0,0,0"/><Button x:Name="SaveDefaultObsidianSourceButton" DockPanel.Dock="Right" Content="保存设置" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0"/><Button x:Name="BrowseDefaultObsidianSourceButton" DockPanel.Dock="Right" Content="选择目录" Margin="8,0,0,0"/><TextBox x:Name="DefaultObsidianSourceBox" IsReadOnly="True" Margin="0,3,0,12"/></DockPanel>
              <TextBlock x:Name="DefaultObsidianSourceHintText" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap"/>
            </StackPanel>
          </Border>
          <Border Background="{DynamicResource SurfaceBackground}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="24" Margin="0,0,0,16">
            <StackPanel>
              <TextBlock Text="项目维护" Style="{StaticResource TitleTextStyle}" FontSize="18" Foreground="{DynamicResource TextPrimary}"/>
              <TextBlock Text="检查数据一致性或打开运行日志。" Foreground="{DynamicResource TextSecondary}" Margin="0,4,0,16" TextWrapping="Wrap"/>
              <StackPanel Orientation="Horizontal"><Button x:Name="MaintenanceCheckButton" Content="运行项目自检" Style="{StaticResource PrimaryButton}"/><Button x:Name="MaintenanceLogButton" Content="查看日志"/></StackPanel>
            </StackPanel>
          </Border>
          <Border Background="{DynamicResource SurfaceBackground}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="24">
            <StackPanel>
              <TextBlock Text="版本管理" Style="{StaticResource TitleTextStyle}" FontSize="18" Foreground="{DynamicResource TextPrimary}"/>
              <TextBlock x:Name="CurrentVersionText" Foreground="{DynamicResource TextSecondary}" Margin="0,4,0,16" TextWrapping="Wrap"/>
              <StackPanel><TextBlock Text="回滚版本号" Style="{DynamicResource FieldLabelStyle}"/><TextBox x:Name="RollbackVersionBox"/><Button x:Name="LoadSnapshotsButton" Content="加载快照"/><DataGrid x:Name="SnapshotGrid" Height="130" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" Margin="0,8,0,8"><DataGrid.Columns><DataGridTextColumn Header="快照" Binding="{Binding Name}" Width="2*"/><DataGridTextColumn Header="时间" Binding="{Binding LastWriteTime}" Width="*"/></DataGrid.Columns></DataGrid><Button x:Name="RollbackButton" Content="回滚选中快照"/></StackPanel>
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>

      <Grid x:Name="TimelinePage" Visibility="Collapsed">
        <Grid.ColumnDefinitions><ColumnDefinition Width="1.08*"/><ColumnDefinition Width="0.92*"/></Grid.ColumnDefinitions>
        <Border Grid.Column="0" Background="{DynamicResource SurfaceBackground}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12">
          <DataGrid x:Name="TimelineGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" SelectionMode="Single" SelectionUnit="FullRow" GridLinesVisibility="Horizontal" HeadersVisibility="Column" RowHeight="52" BorderThickness="0" Background="{DynamicResource SurfaceBackground}"><DataGrid.Columns><DataGridTextColumn Header="标题" Binding="{Binding title}" Width="2*" ElementStyle="{StaticResource GridTextStyle}"/><DataGridTextColumn Header="日期" Binding="{Binding date}" Width="*" ElementStyle="{StaticResource GridTextStyle}"/><DataGridTextColumn Header="优先级" Binding="{Binding priority}" Width="*" ElementStyle="{StaticResource GridTextStyle}"/><DataGridTextColumn Header="状态" Binding="{Binding StateText}" Width="*" ElementStyle="{StaticResource GridTextStyle}"/></DataGrid.Columns></DataGrid>
        </Border>
        <Border Grid.Column="1" Background="{DynamicResource SurfaceBackground}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="24" Margin="18,0,0,0"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
          <TextBlock Text="时间轴条目" Style="{StaticResource TitleTextStyle}" FontSize="18" Foreground="{DynamicResource TextPrimary}"/>
          <TextBlock x:Name="TimelineArticleText" Foreground="{DynamicResource TextSecondary}" Margin="0,4,0,22" TextWrapping="Wrap"/>
          <Button x:Name="TimelineChooseArticleButton" Content="选择文章" Margin="0,0,0,14"/>
          <TextBlock Text="日期（YYYYMMDD）" Style="{DynamicResource FieldLabelStyle}"/><TextBox x:Name="TimelineDateBox"/>
          <TextBlock Text="优先级（数字越小越新）" Style="{DynamicResource FieldLabelStyle}"/><TextBox x:Name="TimelinePriorityBox"/>
          <TextBlock Text="时间轴专用说明" Style="{DynamicResource FieldLabelStyle}"/><TextBox x:Name="TimelineDescriptionBox" MinHeight="90" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/>
          <CheckBox x:Name="TimelineEnabledBox" Content="在时间轴中启用" Margin="0,4,0,16" Foreground="{DynamicResource TextPrimary}"/>
          <StackPanel Orientation="Horizontal"><Button x:Name="TimelineSaveButton" Content="保存条目" Style="{StaticResource PrimaryButton}"/><Button x:Name="TimelineRemoveButton" Content="移除条目"/></StackPanel>
        </StackPanel></ScrollViewer></Border>
      </Grid>
    </Grid>

    <Border Grid.Column="1" Grid.Row="2" Background="{DynamicResource SurfaceMuted}" Padding="30,0"><DockPanel VerticalAlignment="Center">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><TextBlock Text="端口" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondary}" Margin="0,0,6,0"/><TextBox x:Name="PortBox" Width="62" Height="25" Padding="6,3" Margin="0,0,8,0"/><Button x:Name="StartPreviewButton" Content="启动预览" Padding="9,3"/><Button x:Name="StopPreviewButton" Content="停止" Padding="9,3"/><Button x:Name="OpenSiteButton" Content="打开网站" Padding="9,3"/><Button x:Name="CheckButton" Content="自检" Padding="9,3"/><Button x:Name="LogButton" Content="日志" Padding="9,3" Margin="0"/></StackPanel>
      <StackPanel Orientation="Horizontal"><TextBlock x:Name="StatusText" Foreground="{DynamicResource TextSecondary}"/><TextBlock Text="  ·  " Foreground="{DynamicResource TextSecondary}"/><TextBlock x:Name="ServiceStatusText" Foreground="{DynamicResource TextSecondary}"/></StackPanel>
    </DockPanel></Border>
  </Grid>
</Window>
